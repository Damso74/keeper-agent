# Copier en `.env` et remplir. Ne jamais committer le `.env`.

# Clé d'organisation KeeperHub (app.keeperhub.com -> Settings -> API Keys -> Organisation).
# Seule variable réellement sensible de ce dépôt.
KEEPERHUB_API_KEY=kh_votre_cle_ici

# Endpoint MCP. Doit être en HTTPS : l'agent refuse d'envoyer la clé en clair
# vers un hôte distant (seul localhost est toléré pour le développement).
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp

# RPC Sepolia. L'endpoint public par défaut convient pour les lectures d'état,
# mais ne sert pas l'état historique : `scripts/prove-historical-balance.mjs`
# demande un noeud d'archive.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Délai maximal, en millisecondes, de toute requête réseau (RPC et Analytics).
KEEPER_NETWORK_TIMEOUT_MS=15000
